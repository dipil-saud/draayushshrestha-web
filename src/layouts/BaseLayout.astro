---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { imageAssets } from "../data/images";
import { getImage } from "astro:assets";
import "../styles/styles.css";

interface Props {
  title: string;
  description: string;
  canonical: string;
  active: "home" | "about" | "conditions" | "treatments" | "patient-guides" | "contact" | "none";
  image?: string;
  imageAlt?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  modifiedTime?: string;
  structuredData?: Record<string, unknown>[];
}

const defaultSocialImage = await getImage({ src: imageAssets.conferencePresentation, width: 1200, height: 630, format: "jpg" });

const {
  title,
  description,
  canonical,
  active,
  image = new URL(defaultSocialImage.src, Astro.site).href,
  imageAlt = "Dr. Aayush Shrestha, orthopaedic and spine surgeon",
  ogType = "website",
  publishedTime,
  modifiedTime,
  structuredData = [],
} = Astro.props as Props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <script is:inline>document.documentElement.classList.add("js");</script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;600&amp;family=Newsreader:opsz,wght@6..72,500;6..72,700&amp;display=swap" rel="stylesheet" />
    <link rel="icon" type="image/png" sizes="16x16" href="/assets/favicon-16.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/assets/favicon-32.png" />
    <link rel="icon" type="image/x-icon" href="/assets/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/assets/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#002968" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Dr. Aayush Shrestha" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={imageAlt} />
    {structuredData.map((data) => <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />)}
  </head>
  <body>
<!--
THESIS: A conventional clinical-credibility site in the Mayo register — clean cool white, deep clinical navy, serif-meets-sans editorial — proving a Nepal orthopaedic and spine surgeon's expertise through a browsable condition library and reachable care. Refuses the warm-teal editorial accent and any expressive arts-and-crafts world.
OWN-WORLD: cool near-white ground, warm-neutral near-black ink, one committed clinical-navy accent (oklch 38% .14 255) with a deeper navy for text-on-light and the dark-section ground; hairline cool-gray rules; Newsreader serif display + IBM Plex Sans body. Restrained ground, committed accent in banner, CTA, markers, and dark zones.
STORY: a patient or clinician lands, recognizes medical authority, locates their condition in the body-region taxonomy, and reaches the clinic by phone or WhatsApp.
FIRST VIEWPORT: portrait-led hero, the surgeon's name in serif display, a single primary "Book appointment" action in navy, a credential strip; the accent reads clinical blue, not teal.
FORM: canon (category standard, peer Mayo Clinic); the roll's assigned Wayfinding/saffron world (seed 8e2f7e28) was refused by the user for the conventional door.
FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md
-->
    <a class="skip-link" href="#main">Skip to content</a>
    <Header active={active} />
    <slot />
    <Footer />
    <script is:inline src="/script.js"></script>
  </body>
</html>
