---
import BaseLayout from "../layouts/BaseLayout.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import { whatHurtsCategories } from "../data/what-hurts";

const categoryIds: Record<string, string> = {
  Spine: "spine",
  Shoulder: "upper-limb",
  Knee: "joints",
  "Foot & Ankle": "foot-ankle",
  Elbow: "elbow",
  Hip: "hip",
  "Hand & Wrist": "hand-foot",
  "Rheumatic Conditions": "rheumatic",
  Trauma: "trauma",
};

const conditionLeadByCategory: Record<string, string> = {
  Spine: "Common spinal problems include:",
  Shoulder: "Common shoulder orthopedic problems include:",
  Knee: "Common knee orthopedic problems include:",
  "Foot & Ankle": "Common foot and ankle problems include:",
  Elbow: "Common elbow problems in orthopedics include:",
  Hip: "Common orthopedic hip problems include:",
  "Hand & Wrist": "Common orthopedic hand and wrist problems include:",
  "Rheumatic Conditions": "Common orthopedic rheumatic problems include:",
  Trauma: "Common orthopedic trauma problems treated include:",
};
---

<BaseLayout
  title="Orthopaedic & Spine Conditions | Dr. Aayush Shrestha Nepal"
  description="Explore spine, knee, hip, shoulder, hand, foot, rheumatic and trauma conditions treated by Dr. Aayush Shrestha."
  canonical="https://draayushshrestha.com/conditions.html"
  active="conditions"
>
  <main id="main">
    <section class="conditions-hero"><div class="shell"><p class="kicker">Conditions &amp; symptoms</p><h1>What hurts?</h1><p>Common orthopaedic and spine problems treated by Dr. Aayush Shrestha.</p></div></section>
    <section class="conditions-browser"><div class="shell conditions-layout">
      <aside class="condition-rail"><div class="condition-rail__inner"><p class="kicker">Browse by area</p><nav class="condition-rail__links" aria-label="Condition categories">{whatHurtsCategories.map((category, index) => <a href={`#${categoryIds[category.name]}`}><span>{String(index + 1).padStart(2, "0")}</span>{category.name}</a>)}</nav></div></aside>
      <div class="what-hurts-categories">
        {whatHurtsCategories.map((category) => (
          <section class="what-hurts-category" id={categoryIds[category.name]}>
            <div class="what-hurts-category__lead">
              <div class="what-hurts-category__copy"><h2>{category.name}</h2><p>{category.introduction}</p></div>
              <figure><ResponsiveImage src={category.image.src} sizes="(min-width: 60rem) 39vw, calc(100vw - 2rem)" alt={category.image.alt} /></figure>
            </div>
            <details class="condition-group">
              <summary><span>{conditionLeadByCategory[category.name]}</span><span>{category.conditions.length} conditions</span></summary>
              <div class="condition-definitions-list">
                {category.conditions.map((condition) => <article><h3>{condition.name}</h3><p>{condition.description}</p></article>)}
              </div>
            </details>
          </section>
        ))}
      </div>
    </div></section>
    <section class="section section--dark"><div class="shell cta-band"><h2>Not every condition requires surgery</h2><div><p>Care may include education, rehabilitation, medication, injections or surgery depending on the diagnosis and individual needs.</p><p class="action-block"><a class="btn btn--light" href="treatments.html">Explore treatments</a></p></div></div></section>
  </main>
</BaseLayout>
