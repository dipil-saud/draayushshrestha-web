<BaseLayout
  title="Image Credits | Dr. Aayush Shrestha"
  description="Credits and licences for third-party medical images used on this website."
  canonical="https://draayushshrestha.com/image-credits"
  active="none"
>
  <main id="main">
    <section class="shell page-hero"><h1>Image credits</h1><p>Third-party medical images used on this website are hosted locally and adapted through resizing, cropping, background treatment or web-format conversion.</p></section>
    <section class="section section--tight"><div class="narrow image-credit-list">
      {credits.map((credit) => (
        <article>
          <h2>{credit.title}</h2>
          <p>By {credit.creator}. <a href={credit.source}>View source</a> · <a href={credit.licenseUrl}>{credit.license}</a>.</p>
        </article>
      ))}
    </div></section>
  </main>
</BaseLayout>
