---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalClinic",
    "@id": "https://draayushshrestha.com/#pacific-clinic",
    name: "Pacific Multispeciality Clinic",
    url: "https://draayushshrestha.com/contact",
    telephone: "+977-1-5424290",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Kupondole",
      addressLocality: "Lalitpur",
      addressCountry: "NP",
    },
    employee: { "@id": "https://draayushshrestha.com/#doctor" },
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "appointments",
      telephone: "+977-9745616846",
    },
  },
];
---

<BaseLayout
  title="Book an Orthopaedic Appointment | Dr. Aayush Shrestha"
  description="Book an orthopaedic or spine consultation with Dr. Aayush Shrestha at Pacific Multispeciality Clinic in Kupondole, Lalitpur, Nepal."
  canonical="https://draayushshrestha.com/contact"
  active="contact"
  structuredData={structuredData}
>
  <main id="main">
    <section class="contact-page"><div class="shell">
      <header class="contact-page__header">
        <div><p class="kicker">Appointments</p><h1>Contact</h1><p>Call or message us to book a consultation.</p></div>
      </header>
      <div class="contact-layout">
        <iframe class="map-frame map-frame--large" title="Pacific Multispeciality Clinic map" loading="lazy" src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d17462.16185184436!2d85.3163951!3d27.6880716!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39eb1988b3face2b%3A0x8a08f3709437d9af!2sPacific%20Multispeciality%20Clinic!5e1!3m2!1sen!2snp!4v1723462723220!5m2!1sen!2snp"></iframe>
        <div class="contact-details">
          <div class="contact-page__clinic"><h2>Pacific Multispeciality Clinic</h2><p>Kupondole, Lalitpur, Nepal</p><a class="text-link" href="https://maps.app.goo.gl/vqc996vyPpPjq9r99" target="_blank" rel="noopener">Open directions ↗</a></div>
          <div class="contact-actions" role="group" aria-label="Contact options">
            <a class="contact-action" href="tel:+9779841382407"><span>Call</span><strong>+977&nbsp;984&nbsp;138&nbsp;2407</strong></a>
            <a class="contact-action" href="https://wa.me/9779841382407"><span>WhatsApp</span><strong>Message now ↗</strong></a>
            <a class="contact-action" href="tel:+9779745616846"><span>Appointments</span><strong>+977&nbsp;974&nbsp;561&nbsp;6846</strong></a>
            <a class="contact-action" href="tel:+97715424290"><span>Clinic</span><strong>01&#8209;5424290</strong></a>
          </div>
          <nav class="contact-utility" aria-label="Additional contact links">
            <a href="mailto:draayushshrestha@gmail.com">Email</a>
            <a href="https://www.instagram.com/orthopedics.spine/">Instagram ↗</a>
            <a href="https://www.facebook.com/profile.php?id=100082830189784">Facebook ↗</a>
          </nav>
        </div>
      </div>
    </div></section>
    <Faq />
  </main>
</BaseLayout>
