---
import BaseLayout from "../layouts/BaseLayout.astro";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalClinic",
    "@id": "https://draayushshrestha.com/#pacific-clinic",
    name: "Pacific Multispeciality Clinic",
    url: "https://draayushshrestha.com/contact.html",
    telephone: "+977-1-5424290",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Kupondole, near Bagmati Bridge",
      addressLocality: "Lalitpur",
      addressCountry: "NP",
    },
    employee: { "@id": "https://draayushshrestha.com/#doctor" },
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "appointments",
      telephone: "+977-9745616846",
    },
  },
];
---

<BaseLayout
  title="Book an Orthopaedic Appointment | Dr. Aayush Shrestha"
  description="Book an orthopaedic or spine consultation with Dr. Aayush Shrestha at Pacific Multispeciality Clinic in Kupondole, Lalitpur, Nepal."
  canonical="https://draayushshrestha.com/contact.html"
  active="contact"
  structuredData={structuredData}
>
  <main id="main">
    <section class="shell page-hero"><p class="kicker">Appointments</p><h1>Plan your consultation.</h1><p>Contact Pacific Multispeciality Clinic for Dr. Aayush Shrestha’s current schedule and appointment availability.</p></section>
    <section class="section section--tight"><div class="shell contact-grid"><div><h2>Pacific Multispeciality Clinic</h2><p class="action-block">Kupondole, Lalitpur<br>Near Bagmati Bridge<br>Nepal</p><div class="contact-list"><a href="tel:+9779745616846"><span>Appointments</span><strong>+977&nbsp;974&nbsp;561&nbsp;6846</strong></a><a href="tel:+97715424290"><span>Clinic&nbsp;telephone</span><strong>01&#8209;5424290</strong></a><a href="https://wa.me/9779841382407"><span>WhatsApp</span><strong>+977&nbsp;984&nbsp;138&nbsp;2407</strong></a><a href="mailto:draayushshrestha@gmail.com"><span>Email</span><strong>draayushshrestha@gmail.com</strong></a><a href="https://maps.app.goo.gl/vqc996vyPpPjq9r99" target="_blank" rel="noopener"><span>Directions</span><strong>Open Google Maps ↗</strong></a></div></div><iframe class="map-frame" title="Pacific Multispeciality Clinic map" loading="lazy" src="https://www.google.com/maps/embed?pb=!1m14!1m8!1m3!1d17462.16185184436!2d85.3163951!3d27.6880716!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39eb1988b3face2b%3A0x8a08f3709437d9af!2sPacific%20Multispeciality%20Clinic!5e1!3m2!1sen!2snp!4v1723462723220!5m2!1sen!2snp"></iframe></div></section>
    <section class="section section--paper-2"><div class="shell"><div class="section-head"><h2>Prepare for your visit</h2><p>A few details help make the first consultation more useful.</p></div><div class="directory"><article class="directory__item"><h3>Bring records</h3><p>Previous prescriptions, reports, discharge summaries, X-rays and MRI/CT images.</p></article><article class="directory__item"><h3>List symptoms</h3><p>When they began, what worsens or relieves them, and any numbness or weakness.</p></article><article class="directory__item"><h3>List medicines</h3><p>Include regular medicines, allergies and relevant medical conditions.</p></article></div></div></section>
    <section class="section section--dark"><div class="shell cta-band"><h2>Need a quick appointment check?</h2><div><p>WhatsApp the clinic using the published contact number.</p><p class="action-block"><a class="btn btn--light" href="https://wa.me/9779841382407">Open WhatsApp</a></p></div></div></section>
  </main>
</BaseLayout>
