---
import BaseLayout from "../layouts/BaseLayout.astro";
import Faq from "../components/Faq.astro";
import { googleReviewSummary } from "../data/google-reviews";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "MedicalClinic",
    "@id": "https://draayushshrestha.com/#pacific-clinic",
    name: "Pacific Multispeciality Clinic",
    url: "https://draayushshrestha.com/contact",
    telephone: "+977-1-5424290",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Kupondole",
      addressLocality: "Lalitpur",
      addressCountry: "NP",
    },
    employee: { "@id": "https://draayushshrestha.com/#doctor" },
    contactPoint: {
      "@type": "ContactPoint",
      contactType: "appointments",
      telephone: "+977-9745616846",
    },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: googleReviewSummary.rating,
      reviewCount: googleReviewSummary.reviewCount,
      bestRating: "5",
      worstRating: "1",
    },
    sameAs: [googleReviewSummary.profileUrl],
  },
];
---

<BaseLayout
  title="Book an Orthopaedic Appointment | Dr. Aayush Shrestha"
  description="Book an orthopaedic or spine consultation with Dr. Aayush Shrestha at Grande International Hospital, Tokha, Kathmandu, or Pacific Multispeciality Clinic, Kupondole, Lalitpur."
  canonical="https://draayushshrestha.com/contact"
  active="contact"
  structuredData={structuredData}
>
  <main id="main">
    <section class="contact-page"><div class="shell">
      <header class="contact-page__header">
        <div><p class="kicker">Appointments</p><h1>Contact</h1><p>Consultations are available in Kathmandu and Lalitpur. Call the location you want to visit.</p></div>
      </header>
      <div class="locations">
        <section class="location" aria-labelledby="location-kathmandu">
          <iframe class="location__map" title="Grande International Hospital map" loading="lazy" src="https://www.google.com/maps?q=Grande+International+Hospital,+Tokha&output=embed"></iframe>
          <div class="location__body">
            <p class="kicker">Kathmandu</p>
            <h2 id="location-kathmandu">Grande International Hospital</h2>
            <p class="location__address">Tokha, Kathmandu, Bagmati Province 44600</p>
            <ul class="contact-list">
              <li><div><span>Hours</span><strong>Sunday to Friday, 9am to 5pm</strong></div></li>
              <li><a href="tel:+97715159266"><span>Hospital</span><strong>01&#8209;5159266</strong></a></li>
            </ul>
            <a class="text-link" href="https://www.google.com/maps/search/?api=1&query=Grande+International+Hospital+Tokha" target="_blank" rel="noopener">Open directions ↗</a>
          </div>
        </section>
        <section class="location" aria-labelledby="location-lalitpur">
          <iframe class="location__map" title="Pacific Multispeciality Clinic map" loading="lazy" src="https://www.google.com/maps?q=Pacific+Multispeciality+Clinic,+Kupondole,+Lalitpur&output=embed"></iframe>
          <div class="location__body">
            <p class="kicker">Lalitpur</p>
            <h2 id="location-lalitpur">Pacific Multispeciality Clinic</h2>
            <p class="location__address">Kupondole, Lalitpur, Nepal</p>
            <ul class="contact-list">
              <li><div><span>Hours</span><strong>Monday to Friday, after 5pm</strong></div></li>
              <li><a href="tel:+97715424290"><span>Clinic</span><strong>01&#8209;5424290</strong></a></li>
              <li><a href="tel:+9779745616846"><span>Appointments</span><strong>+977&nbsp;974&nbsp;561&nbsp;6846</strong></a></li>
            </ul>
            <a class="text-link" href="https://maps.app.goo.gl/vqc996vyPpPjq9r99" target="_blank" rel="noopener">Open directions ↗</a>
          </div>
        </section>
      </div>
      <div class="contact-more">
        <section class="contact-general" aria-labelledby="contact-general">
          <h2 id="contact-general">Contact Dr. Shrestha directly</h2>
          <ul class="contact-list">
            <li><a href="tel:+9779841382407"><span>Call</span><strong>+977&nbsp;984&nbsp;138&nbsp;2407</strong></a></li>
            <li><a href="https://wa.me/9779841382407"><span>WhatsApp</span><strong>Message now ↗</strong></a></li>
            <li><a href="mailto:draayushshrestha@gmail.com"><span>Email</span><strong>draayushshrestha@gmail.com</strong></a></li>
          </ul>
        </section>
        <section class="contact-general" aria-labelledby="contact-online">
          <h2 id="contact-online">Reviews and social media</h2>
          <ul class="contact-list">
            <li><a href={googleReviewSummary.profileUrl} target="_blank" rel="noopener"><span><svg class="contact-list__icon" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>Google reviews</span><strong>{googleReviewSummary.rating} from {googleReviewSummary.reviewCount} reviews ↗</strong></a></li>
            <li><a href="https://www.instagram.com/orthopedics.spine/" target="_blank" rel="noopener"><span>Instagram</span><strong>@orthopedics.spine ↗</strong></a></li>
            <li><a href="https://www.facebook.com/profile.php?id=100082830189784" target="_blank" rel="noopener"><span>Facebook</span><strong>Visit page ↗</strong></a></li>
            <li><a href="https://youtube.com/@dr.AayushShrestha" target="_blank" rel="noopener"><span>YouTube</span><strong>@dr.AayushShrestha ↗</strong></a></li>
            <li><a href="https://www.tiktok.com/@dr.aayush.shrestha" target="_blank" rel="noopener"><span>TikTok</span><strong>@dr.aayush.shrestha ↗</strong></a></li>
            <li><a href="https://www.linkedin.com/in/dr-aayush-shrestha-b7b044165" target="_blank" rel="noopener"><span>LinkedIn</span><strong>View profile ↗</strong></a></li>
          </ul>
        </section>
      </div>
    </div></section>
    <Faq />
  </main>
</BaseLayout>
