---
import BaseLayout from "../layouts/BaseLayout.astro";

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://draayushshrestha.com/#doctor",
    name: "Dr. Aayush Shrestha",
    honorificPrefix: "Dr.",
    jobTitle: "Orthopaedic and Spine Surgeon",
    description: "Orthopaedic and spine surgeon practising in Kathmandu and Lalitpur, Nepal.",
    url: "https://draayushshrestha.com/about.html",
    image: "https://draayushshrestha.com/assets/images/doctor-white-coat.jpg",
    telephone: "+977-9841382407",
    email: "draayushshrestha@gmail.com",
    alumniOf: [
      { "@type": "EducationalOrganization", name: "University of Dhaka" },
      { "@type": "EducationalOrganization", name: "Kathmandu University" },
    ],
    worksFor: [
      { "@type": "Hospital", name: "Grande International Hospital" },
      { "@id": "https://draayushshrestha.com/#pacific-clinic" },
    ],
    knowsAbout: ["Orthopaedic surgery", "Spine surgery", "Endoscopic spine surgery"],
    sameAs: ["https://www.instagram.com/orthopedics.spine/", "https://youtube.com/@dr.AayushShrestha", "https://www.linkedin.com/in/dr-aayush-shrestha-b7b044165"],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://draayushshrestha.com/#website",
    url: "https://draayushshrestha.com/",
    name: "Dr. Aayush Shrestha",
    inLanguage: "en",
    publisher: { "@id": "https://draayushshrestha.com/#doctor" },
  },
];
---

<BaseLayout
  title="Orthopaedic & Spine Surgeon in Nepal | Dr. Aayush Shrestha"
  description="Consult Dr. Aayush Shrestha, an orthopaedic and spine surgeon in Kathmandu and Lalitpur, Nepal. Explore conditions and appointments."
  canonical="https://draayushshrestha.com/"
  active="home"
  structuredData={structuredData}
>

  <main id="main">
    <section class="hero"><div class="shell hero__grid"><div class="hero__copy"><p class="kicker">Orthopaedic and Spine Surgeon</p><h1>Dr. Aayush Shrestha</h1><p class="hero__lede">MBBS, MS Orthopaedics, Fellowship in Spine Surgery. Practising at Grande International Hospital, Tokha, and Pacific Multispeciality Clinic, Kupondole.</p><div class="hero__actions"><a class="btn btn--primary" href="contact.html">Book an appointment</a><a class="btn" href="conditions.html">What hurts?</a></div></div><figure class="hero__portrait"><img src="assets/images/doctor-white-coat.jpg" width="1024" height="1280" fetchpriority="high" alt="Dr. Aayush Shrestha in a white medical coat"><figcaption class="hero__caption">Orthopaedic and spine consultations in Kathmandu and Lalitpur.</figcaption></figure></div></section>

    <section class="credential-strip" aria-label="Professional overview"><ul class="shell"><li><strong>More than 15 years</strong><span>Experience in orthopaedic care</span></li><li><strong>Fellowship in Spine Surgery</strong><span>Grande International Hospital</span></li><li><strong>Endoscopic Spine Surgery</strong><span>Additional focused training</span></li></ul></section>

    <section class="section section--paper-2"><div class="shell"><div class="section-head section-head--stacked section-head--flush"><h2>Trusted name in orthopaedics</h2><p>Dr. Aayush Shrestha is an orthopaedic surgeon with a fellowship in spine surgery. He has been a practising doctor for more than 15 years and currently practises at Grande International Hospital, Tokha, and Pacific Multispeciality Clinic, Kupondole.</p></div></div></section>

    <section class="section home-practice"><div class="shell"><div class="split"><div class="split__copy"><h3>Spine surgery</h3><p>His clinical focus includes spine diseases, back pain, neck pain, disc herniation, degenerative conditions, infections and spinal trauma.</p></div><figure class="split__media"><img src="assets/images/conference-presentation.jpg" width="1600" height="1066" loading="lazy" alt="Dr. Aayush Shrestha presenting on spinal surgery"></figure></div><div class="split split--reverse"><div class="split__copy"><h3>Orthopaedic surgery</h3><p>His specialisation includes musculoskeletal trauma, knee pain, shoulder pain, sports injuries, joint conditions and other musculoskeletal problems.</p></div><figure class="split__media"><img src="assets/images/knee-pain.jpg" width="1200" height="675" loading="lazy" alt="Person holding a painful knee"></figure></div></div></section>

    <section class="section section--paper-2"><div class="shell"><div class="section-head section-head--stacked section-head--compact"><h2>Affiliations</h2><p>Dr. Shrestha is affiliated with Grande International Hospital, Pacific Multispeciality Clinic and Shankhamul Healthcare.</p></div><div class="logo-wall logo-wall--large"><ul><li><a href="https://grandehospital.com/"><img src="assets/images/grande-hospital.png" width="500" height="500" alt="Grande International Hospital"></a></li><li><a href="https://pacificclinic.com.np/"><img src="assets/images/pacific-clinic.png" width="500" height="500" alt="Pacific Multispeciality Clinic"></a></li><li><a href="https://shankhamulhealthcare.com.np/"><img src="assets/images/shankhamul-healthcare.png" width="892" height="893" alt="Shankhamul Healthcare"></a></li></ul></div></div></section>

    <section class="section section--dark"><div class="shell"><div class="section-head section-head--stacked"><h2>What hurts?</h2><p>Common orthopaedic and spine problems grouped by body area. This information does not replace an examination or diagnosis.</p></div><div class="body-map"><a href="conditions.html#spine"><strong>Back &amp; spine</strong><span>Disc, nerve, stenosis, deformity</span></a><a href="conditions.html#spine"><strong>Neck</strong><span>Pain, stiffness, arm symptoms</span></a><a href="conditions.html#joints"><strong>Knee &amp; hip</strong><span>Arthritis, injury, mobility</span></a><a href="conditions.html#upper-limb"><strong>Shoulder &amp; elbow</strong><span>Tendon, instability, trauma</span></a><a href="conditions.html#hand-foot"><strong>Hand, wrist &amp; foot</strong><span>Nerve, tendon, joint pain</span></a><a href="conditions.html#trauma"><strong>Trauma</strong><span>Fractures and dislocations</span></a></div></div></section>

    <section class="section"><div class="narrow"><p class="kicker">Patient perspective</p><div class="quote"><blockquote>“Dr. Aayush is one of the most well-spoken and comforting doctors I’ve ever met. Really takes his time examining and also making the patient understand the situation.”</blockquote><cite>Arjesh Karmacharya · Grande International Hospital, Nepal</cite><a class="text-link" href="about.html#reviews">Read patient experiences →</a></div></div></section>

    <section class="section section--paper-2"><div class="shell"><div class="section-head section-head--stacked"><h2>Know your body</h2><p>Patient education on danger signs, health tips, spine care and common orthopaedic questions.</p></div><div class="article-grid"><article class="article-card"><p class="kicker">Danger signs</p><h3>Signs of nerve compression in the neck</h3><a class="text-link" href="patient-guides.html#nerve-compression">Read the guide →</a></article><article class="article-card"><p class="kicker">Health tips</p><h3>Tips to maintain healthy knees</h3><a class="text-link" href="patient-guides.html#healthy-knees">Read the guide →</a></article><article class="article-card"><p class="kicker">Myths and facts</p><h3>Disc herniation</h3><a class="text-link" href="patient-guides.html#disc-herniation">Read the guide →</a></article></div></div></section>

    <section class="section section--dark"><div class="shell cta-band"><h2>Get in touch</h2><div><p>Message us to book an appointment at Pacific Multispeciality Clinic, Kupondole.</p><p class="action-block"><a class="btn btn--light" href="contact.html">Contact us</a></p></div></div></section>
  </main>

</BaseLayout>
