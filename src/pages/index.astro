---
import BaseLayout from "../layouts/BaseLayout.astro";
import Affiliations from "../components/Affiliations.astro";
import Faq from "../components/Faq.astro";
import ResponsiveImage from "../components/ResponsiveImage.astro";
import Videos from "../components/Videos.astro";
import { googleReviews, googleReviewSummary } from "../data/google-reviews";
import { imageAssets } from "../data/images";

const doctorImage = new URL(imageAssets.doctorWhiteCoat.src, Astro.site).href;

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Person",
    "@id": "https://draayushshrestha.com/#doctor",
    name: "Dr. Aayush Shrestha",
    honorificPrefix: "Dr.",
    jobTitle: "Orthopaedic and Spine Surgeon",
    description: "Orthopaedic and spine surgeon practising in Kathmandu and Lalitpur, Nepal.",
    url: "https://draayushshrestha.com/about",
    image: doctorImage,
    telephone: "+977-9841382407",
    email: "draayushshrestha@gmail.com",
    alumniOf: [
      { "@type": "EducationalOrganization", name: "University of Dhaka" },
      { "@type": "EducationalOrganization", name: "Kathmandu University" },
    ],
    worksFor: [
      { "@type": "Hospital", name: "Grande International Hospital" },
      { "@id": "https://draayushshrestha.com/#pacific-clinic" },
    ],
    knowsAbout: ["Orthopaedic surgery", "Spine surgery", "Endoscopic spine surgery"],
    sameAs: ["https://www.instagram.com/orthopedics.spine/", "https://youtube.com/@dr.AayushShrestha", "https://www.linkedin.com/in/dr-aayush-shrestha-b7b044165", "https://www.facebook.com/profile.php?id=100082830189784", "https://www.tiktok.com/@dr.aayush.shrestha", "https://share.google/9Kj5c89U9UB5Ftcmv"],
  },
  {
    "@context": "https://schema.org",
    "@type": "MedicalClinic",
    "@id": "https://draayushshrestha.com/#pacific-clinic",
    name: "Pacific Multispeciality Clinic",
    url: "https://draayushshrestha.com/contact",
    telephone: "+977-1-5424290",
    address: {
      "@type": "PostalAddress",
      streetAddress: "Kupondole",
      addressLocality: "Lalitpur",
      addressCountry: "NP",
    },
    employee: { "@id": "https://draayushshrestha.com/#doctor" },
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: googleReviewSummary.rating,
      reviewCount: googleReviewSummary.reviewCount,
      bestRating: "5",
      worstRating: "1",
    },
    sameAs: [googleReviewSummary.profileUrl],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "@id": "https://draayushshrestha.com/#website",
    url: "https://draayushshrestha.com/",
    name: "Dr. Aayush Shrestha",
    inLanguage: "en",
    publisher: { "@id": "https://draayushshrestha.com/#doctor" },
  },
];
---

<BaseLayout
  title="Orthopaedic & Spine Surgeon in Nepal | Dr. Aayush Shrestha"
  description="Consult Dr. Aayush Shrestha, an orthopaedic and spine surgeon in Kathmandu and Lalitpur, Nepal. Explore conditions and appointments."
  canonical="https://draayushshrestha.com/"
  active="home"
  structuredData={structuredData}
>

  <main id="main">
    <section class="hero"><div class="shell hero__grid"><div class="hero__copy"><p class="kicker">Orthopaedic and Spine Surgeon</p><h1>Dr. Aayush Shrestha</h1><p class="hero__lede">MBBS, MS Orthopaedics, Fellowship in Spine Surgery. Practising at Grande International Hospital, Tokha, and Pacific Multispeciality Clinic, Kupondole.</p><div class="hero__actions"><a class="btn btn--primary" href="contact">Book an appointment</a></div></div><figure class="hero__portrait"><ResponsiveImage src={imageAssets.doctorWhiteCoat} sizes="(min-width: 60rem) 38vw, calc(100vw - 2rem)" loading="eager" fetchpriority="high" alt="Dr. Aayush Shrestha in a white medical coat" /><figcaption class="hero__caption">Orthopaedic and spine consultations in Kathmandu and Lalitpur.</figcaption></figure></div></section>

    <section class="credential-strip" aria-label="Professional overview"><ul class="shell"><li><strong>More than 15 years</strong><span>Experience in orthopaedic care</span></li><li><strong>Fellowship in Spine Surgery</strong><span>Grande International Hospital</span></li><li><strong>Endoscopic Spine Surgery</strong><span>Additional focused training</span></li><li><a class="credential-strip__rating" href={googleReviewSummary.profileUrl} target="_blank" rel="noopener"><strong><svg class="credential-strip__star" viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>{googleReviewSummary.rating} on Google</strong><span>{googleReviewSummary.reviewCount} patient reviews ↗</span></a></li></ul></section>

    <section class="section section--tight section--paper-2"><div class="shell"><div class="section-head section-head--stacked section-head--flush"><h2>Trusted name in orthopaedics</h2><p>Dr. Aayush Shrestha is an orthopaedic surgeon with a fellowship in spine surgery. He has been a practising doctor for more than 15 years and currently practises at Grande International Hospital, Tokha, and Pacific Multispeciality Clinic, Kupondole.</p></div></div></section>

    <section class="section home-practice"><div class="shell"><div class="section-head section-head--stacked"><h2>Areas of practice</h2><p>Specialist assessment and treatment for orthopaedic and spine conditions.</p></div><div class="split"><div class="split__copy"><h3>Spine surgery</h3><p>His clinical focus includes spine diseases, back pain, neck pain, disc herniation, degenerative conditions, infections and spinal trauma.</p><a class="text-link" href="treatments#spine-surgery">Explore spine treatments →</a></div><figure class="split__media"><ResponsiveImage src={imageAssets.conferencePresentation} sizes="(min-width: 60rem) 45vw, calc(100vw - 2rem)" alt="Dr. Aayush Shrestha presenting on spinal surgery" /></figure></div><div class="split split--reverse"><div class="split__copy"><h3>Orthopaedic surgery</h3><p>His specialisation includes musculoskeletal trauma, knee pain, shoulder pain, sports injuries, joint conditions and other musculoskeletal problems.</p><a class="text-link" href="treatments#orthopaedic-surgery">Explore orthopaedic treatments →</a></div><figure class="split__media"><ResponsiveImage src={imageAssets.surgery} sizes="(min-width: 60rem) 45vw, calc(100vw - 2rem)" alt="Dr. Aayush Shrestha working with a surgical team" /></figure></div></div></section>

    <Affiliations />

    <section class="section section--dark"><div class="shell"><div class="section-head section-head--stacked"><h2>What hurts?</h2><p>Common orthopaedic and spine problems grouped by body area. This information does not replace an examination or diagnosis.</p></div><div class="body-map"><a href="conditions#spine"><strong>Back &amp; spine</strong><span>Disc, nerve, stenosis, deformity</span></a><a href="conditions#spine"><strong>Neck</strong><span>Pain, stiffness, arm symptoms</span></a><a href="conditions#joints"><strong>Knee &amp; hip</strong><span>Arthritis, injury, mobility</span></a><a href="conditions#upper-limb"><strong>Shoulder &amp; elbow</strong><span>Tendon, instability, trauma</span></a><a href="conditions#hand-foot"><strong>Hand, wrist &amp; foot</strong><span>Nerve, tendon, joint pain</span></a><a href="conditions#trauma"><strong>Trauma</strong><span>Fractures and dislocations</span></a></div><div class="home-treatments"><h3>Treatments offered</h3><ul><li>Physiotherapy, rehabilitation, bracing and supports</li><li>Pain medication and lifestyle modification</li><li>Steroid, PRP and hyaluronic acid injections</li><li>Fracture fixation</li><li>Spine decompression and fusion</li><li>Tumour surgery</li></ul><a class="text-link" href="treatments">Explore treatment options →</a></div></div></section>

    <section class="section patient-perspectives">
      <div class="shell">
        <div class="section-head">
          <div><p class="kicker">Google reviews</p><h2>Patient perspectives</h2></div>
          <p>Public reviews from real patients, shared on Google.</p>
        </div>
        <div class="testimonial-list">
          {googleReviews.map((review) => (
            <article class="testimonial">
              <header class="testimonial__head">
                <span class="testimonial__avatar" aria-hidden="true">{review.name.charAt(0).toUpperCase()}</span>
                <div>
                  <cite>{review.name}</cite>
                  <p class="testimonial__rating" role="img" aria-label={`${review.rating} out of 5 stars`}>{Array.from({ length: 5 }, (_, i) => <svg class={i < review.rating ? "is-filled" : undefined} viewBox="0 0 24 24" aria-hidden="true"><path d="M12 17.27 18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z" /></svg>)}</p>
                </div>
              </header>
              <blockquote>
                {review.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              </blockquote>
              <a class="testimonial__link" href={review.url} target="_blank" rel="noopener">Read on Google ↗</a>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section section--paper-2"><div class="shell"><div class="section-head section-head--stacked"><h2>Know your body</h2><p>Patient education on danger signs, health tips, spine care and common orthopaedic questions.</p></div><div class="article-grid"><article class="article-card"><p class="kicker">Danger signs</p><h3>Signs of nerve compression in the neck</h3><a class="text-link" href="patient-guides/nerve-compression">Read the guide →</a></article><article class="article-card"><p class="kicker">Health tips</p><h3>Tips to maintain healthy knees</h3><a class="text-link" href="patient-guides/healthy-knees">Read the guide →</a></article><article class="article-card"><p class="kicker">Myths and facts</p><h3>Disc herniation</h3><a class="text-link" href="patient-guides/disc-herniation">Read the guide →</a></article></div><Videos /></div></section>

    <Faq />

  </main>

</BaseLayout>
