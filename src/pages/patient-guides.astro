---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Guide {
  id: string;
  category: "Danger signs" | "Health tips" | "Myths and facts";
  title: string;
  paragraphs: string[];
  points: { label?: string; text: string }[];
  closing?: string;
}

const guides: Guide[] = [
  {
    id: "wound-care",
    category: "Health tips",
    title: "Tips on wound care",
    paragraphs: [
      "Wound care involves steps to clean, protect and promote healing of a wound. The following are some basic steps for wound care:",
    ],
    points: [
      { label: "Clean the wound", text: "Remove any dirt or debris using saline solution or soap and water." },
      { label: "Protect the wound", text: "Cover the wound with a sterile bandage to prevent infection." },
      { label: "Promote healing", text: "Keep the wound moist and covered with a dressing, apply antibiotics if prescribed by a doctor, and keep the wound elevated if possible to reduce swelling." },
      { label: "Monitor the wound", text: "Observe the wound for signs of infection such as redness, increased pain and discharge." },
      { label: "Seek medical attention", text: "If the wound is deep, large or shows signs of infection, seek medical attention from a healthcare professional." },
    ],
    closing: "The specific wound-care steps may vary depending on the type, severity and location of the wound. Consult a healthcare professional for appropriate wound care.",
  },
  {
    id: "exercises-over-50",
    category: "Health tips",
    title: "Best exercises for those over 50",
    paragraphs: [
      "Those who are over 50 years of age tend to have degenerative changes in their joints, especially weight-bearing joints. This can lead to osteoarthritis, which manifests as joint pain and stiffness.",
      "Pain and stiffness often lead to inactivity, which further weakens bones, increases joint stiffness and reduces mobility. The key to having an active life after 50 is to keep moving. Joint loading and range of motion help keep bones and joints healthy.",
      "Low-impact exercise can improve overall health and fitness while reducing strain on the joints.",
    ],
    points: [
      { label: "Walking", text: "A simple, low-impact exercise for cardiovascular health and overall fitness. Intensity and speed can be varied to suit your fitness level." },
      { label: "Swimming", text: "A low-impact exercise that can improve cardiovascular health, build muscle and improve flexibility." },
      { label: "Cycling", text: "A low-impact exercise that can be done indoors on a stationary bike or outdoors." },
      { label: "Yoga", text: "A way to improve flexibility, balance and overall body strength while reducing stress." },
      { label: "Water aerobics", text: "A low-impact cardiovascular workout that reduces strain on the joints." },
    ],
    closing: "Listen to your body and do not push yourself too hard, especially if you have an existing health condition. Consult your doctor before starting a new exercise programme.",
  },
  {
    id: "healthy-spine",
    category: "Health tips",
    title: "Healthy spine tips",
    paragraphs: [
      "A healthy spine is the foundation of a healthy musculoskeletal system. Here are some tips to help keep that foundation strong.",
    ],
    points: [
      { label: "Maintain a healthy weight", text: "Excess weight, especially around the midsection, can pull on the back and weaken abdominal muscles." },
      { label: "Exercise regularly", text: "Regular exercise helps maintain flexibility and strengthens the muscles that support posture." },
      { label: "Review your workstation", text: "Adjust your chair, desk and screen where possible to support a comfortable, neutral body position." },
      { label: "Pay attention to injuries", text: "Bumps, falls and accidents can lead to postural adaptations. Address injuries before they develop into bigger problems." },
      { label: "Choose supportive bedding", text: "A medium-firm mattress can support the spine. A mattress that is too firm may place unwanted pressure on the hips and shoulders when side-sleeping." },
      { label: "See a doctor", text: "A professional assessment can help identify and address problems caused by everyday wear and tear." },
    ],
  },
  {
    id: "spine-surgery-myths",
    category: "Myths and facts",
    title: "Spine surgery: myths and facts",
    paragraphs: [
      "A non-surgical option often seems favourable because surgery has complications that people fear. However, spine surgery has advanced significantly in recent decades. Some conditions require surgery and can cause further harm if surgery is avoided.",
    ],
    points: [
      { label: "Myth", text: "Spine surgery is always invasive and involves a long recovery period." },
      { label: "Fact", text: "Depending on the operation and the individual patient, spine surgery can be minimally invasive, with smaller incisions and quicker recovery." },
      { label: "Myth", text: "Spine surgery is only recommended as a last resort." },
      { label: "Fact", text: "It may be recommended earlier when conservative treatment does not relieve pain or restore function." },
      { label: "Myth", text: "All spine surgeries have a high risk of complications." },
      { label: "Fact", text: "Risk depends on the procedure, the patient’s condition and the surgeon’s experience. Physical therapy and rehabilitation are important parts of recovery." },
    ],
  },
  {
    id: "healthy-knees",
    category: "Health tips",
    title: "Tips to maintain healthy knees",
    paragraphs: [
      "The knee joints are highly mobile, weight-bearing joints and are therefore prone to injury.",
      "There are several things you can do to help maintain the health and function of your knees:",
    ],
    points: [
      { label: "Maintain a healthy weight", text: "Extra weight puts additional stress on the knees and can increase wear, tear and injury risk." },
      { label: "Exercise regularly", text: "Physical activity strengthens the muscles around the knees and improves range of motion. Swimming and cycling are low-impact options." },
      { label: "Wear proper shoes", text: "Choose shoes with support, cushioning, a low heel and good arch support." },
      { label: "Stretch", text: "Stretching before and after exercise can improve flexibility and reduce injury risk." },
      { label: "Take breaks", text: "If work or a hobby involves prolonged kneeling or squatting, take breaks to stand and stretch." },
      { label: "Use good posture", text: "Stand straight with your feet approximately shoulder-width apart." },
      { label: "Avoid excessive strain", text: "Avoid high-impact activity if you have knee pain or are prone to knee injuries." },
      { label: "Lift correctly", text: "Bend your knees and keep heavy objects close to your body." },
    ],
    closing: "Consult a healthcare professional if knee pain persists or you experience other knee problems.",
  },
  {
    id: "workout-pain",
    category: "Danger signs",
    title: "Tips to prevent pain after workouts and sports",
    paragraphs: [
      "Delayed onset muscle soreness, or DOMS, is stiffness and pain that can develop a day or two after physical activity, particularly when the activity is new or uses an unfamiliar muscle group. It is associated with small muscle-fibre tears caused by increased strain.",
      "Symptoms can include stiffness, tenderness, swelling, reduced range of motion and reduced strength. Soreness is often greatest 24 to 48 hours after activity and can last up to a week.",
    ],
    points: [
      { label: "Stay hydrated", text: "Drink water during recovery." },
      { label: "Apply heat or cold", text: "Heat or cold may help reduce soreness." },
      { label: "Massage gently", text: "Gentle massage can reduce stiffness and improve circulation." },
      { label: "Stretch", text: "Stretching can help improve flexibility." },
      { label: "Rest", text: "Allow time for the muscles to recover." },
    ],
    closing: "Consult a healthcare professional if muscle soreness is severe, persistent or accompanied by other concerning symptoms.",
  },
  {
    id: "healthy-neck",
    category: "Health tips",
    title: "Tips to maintain a healthy cervical spine and neck",
    paragraphs: [
      "Problems with the cervical spine mainly cause pain in the back of the neck and shoulder-blade region. Pain can sometimes radiate to the upper limbs when cervical nerves are compressed.",
    ],
    points: [
      { label: "Exercise regularly", text: "Physical activity can strengthen the muscles supporting the cervical spine and improve flexibility and range of motion." },
      { label: "Use good posture", text: "Keep your head and neck neutral, with your ears aligned with your shoulders and your chin level." },
      { label: "Avoid excessive strain", text: "Avoid twisting or bending the neck in unnatural ways." },
      { label: "Take breaks", text: "Move and stretch when sitting or standing in one position for long periods." },
      { label: "Use a supportive pillow", text: "A comfortable pillow can reduce neck strain and improve sleep quality." },
      { label: "Raise phones and tablets", text: "Avoid holding devices at a low angle for long periods." },
    ],
    closing: "Consult a healthcare professional if neck pain persists or you experience other cervical-spine problems.",
  },
  {
    id: "surgical-wound",
    category: "Health tips",
    title: "How to take care of a surgical wound",
    paragraphs: [
      "Many patients are unsure how to care for a surgical wound or recognise possible infection. These steps can support wound healing.",
    ],
    points: [
      { label: "Keep the wound clean", text: "Clean it with soap and water, or as instructed by your doctor. Avoid soaking the wound." },
      { label: "Change dressings regularly", text: "Change the dressing as instructed. A dirty or moist dressing can increase infection risk." },
      { label: "Avoid excessive movement", text: "Activities that stress the surgical site can reopen the wound and slow healing." },
      { label: "Take prescribed medicines", text: "Take antibiotics or pain medicine as directed." },
      { label: "Avoid smoking", text: "Smoking can delay healing and increase complication risk." },
      { label: "Eat a balanced diet", text: "Adequate protein, vitamins and minerals support healing." },
      { label: "Watch for infection", text: "Increased pain, redness, swelling and discharge can indicate infection." },
      { label: "Follow up", text: "See your doctor as instructed and raise any concerns." },
      { label: "Avoid unprescribed creams", text: "Do not apply creams or ointments unless instructed by your doctor." },
    ],
  },
  {
    id: "neck-pain-myths",
    category: "Myths and facts",
    title: "Neck pain: myths and facts",
    paragraphs: ["There are several common myths about neck pain:"],
    points: [
      { label: "Myth", text: "Neck pain is always caused by poor posture." },
      { label: "Fact", text: "Poor posture can contribute, but injury, disease and genetics can also play a role." },
      { label: "Myth", text: "You should always rest your neck if it hurts." },
      { label: "Fact", text: "Rest can help in some cases, but staying active and maintaining range of motion can also reduce pain." },
      { label: "Myth", text: "Chiropractic care is the only effective treatment." },
      { label: "Fact", text: "Physical therapy, medication or surgery may be recommended depending on the individual circumstances." },
      { label: "Myth", text: "Neck pain is always a serious problem." },
      { label: "Fact", text: "Some cases are serious, while others improve with self-care." },
    ],
    closing: "Consult a specialist if neck pain is persistent or severe.",
  },
  {
    id: "disc-herniation",
    category: "Myths and facts",
    title: "Disc herniation",
    paragraphs: [
      "Disc herniation can affect people from young adulthood to older age. There are several common myths about the condition.",
    ],
    points: [
      { label: "Myth", text: "Disc herniations only occur in older people." },
      { label: "Fact", text: "They become more common with age but can occur at any age." },
      { label: "Myth", text: "Disc herniations always require surgery." },
      { label: "Fact", text: "Some cases need surgery, while many improve with physical therapy, medication and other non-surgical measures." },
      { label: "Myth", text: "Disc herniations only cause back pain." },
      { label: "Fact", text: "They can also cause pain, numbness or weakness in the legs or arms." },
      { label: "Myth", text: "Disc herniations are always caused by injury or trauma." },
      { label: "Fact", text: "Trauma can be a cause, but posture, obesity and genetics can also contribute." },
    ],
    closing: "Treatment depends on the individual circumstances. Consult a healthcare professional for diagnosis and a treatment plan.",
  },
  {
    id: "back-pain",
    category: "Health tips",
    title: "Back pain tips",
    paragraphs: [
      "Back pain is a common problem that can reduce quality of life and interfere with work and activity.",
    ],
    points: [
      { label: "Practise good posture", text: "Stand straight and avoid slouching. When sitting, use a chair that supports the natural curves of the spine." },
      { label: "Exercise regularly", text: "Activity helps keep the spine strong and flexible. Yoga, swimming and cycling are lower-impact options." },
      { label: "Maintain a healthy weight", text: "Excess weight increases stress on the spine. A balanced diet and regular activity can help." },
    ],
  },
  {
    id: "nerve-compression",
    category: "Danger signs",
    title: "Signs of nerve compression in the neck",
    paragraphs: [
      "Neck pain is often related to posture or muscle strain, but an underlying condition can sometimes cause localised pain or pain that radiates into the arms and hands.",
      "Signs and symptoms can include:",
    ],
    points: [
      { text: "Sharp, burning or shooting pain in the neck, shoulder, arm or hand." },
      { text: "Numbness or tingling in the neck, shoulder, arm or hand." },
      { text: "Weakness in the arm, hand or fingers." },
      { text: "Difficulty with fine motor skills such as buttoning clothes or writing." },
      { text: "Loss of sensation or weakness in a leg or foot when compression is severe." },
      { text: "Headaches at the back of the head or base of the skull." },
      { text: "Dizziness or vertigo." },
      { text: "Loss of bladder or bowel control when compression is severe." },
    ],
    closing: "See a doctor promptly if you experience these symptoms. Nerve compression can have several causes, and early treatment can help prevent further damage.",
  },
];
---

<BaseLayout
  title="Orthopaedic Patient Guides | Dr. Aayush Shrestha"
  description="Read Dr. Aayush Shrestha’s patient education on wound care, exercise, spine and knee health, neck pain, disc herniation and warning signs."
  canonical="https://draayushshrestha.com/patient-guides.html"
  active="patient-guides"
>
  <main id="main">
    <section class="shell page-hero guides-hero"><p class="kicker">Patient education</p><h1>Know your body</h1><p>Health tips, danger signs, and myths and facts about common orthopaedic and spine concerns.</p></section>
    <section class="section section--tight"><div class="shell guide-library">
      {guides.map((guide) => (
        <article class="guide-post" id={guide.id}>
          <header><p class="kicker">{guide.category}</p><h2>{guide.title}</h2><p>April 23, 2024</p></header>
          <details class="condition-disclosure">
            <summary>Read article</summary>
            <div class="guide-post__body">
              {guide.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
              {guide.points.length > 0 && <ul>{guide.points.map((point) => <li>{point.label && <strong>{point.label}: </strong>}{point.text}</li>)}</ul>}
              {guide.closing && <p>{guide.closing}</p>}
              <p class="guide-post__byline">Dr. Aayush Shrestha<br />Orthopaedic and Spine Surgeon</p>
            </div>
          </details>
        </article>
      ))}
    </div></section>
    <section class="section"><div class="narrow"><div class="medical-note"><strong>Medical information notice</strong><p>These articles provide general education and do not replace an individual diagnosis or treatment plan. Seek medical attention for severe or rapidly worsening symptoms.</p></div></div></section>
    <section class="section section--dark"><div class="shell cta-band"><h2>Get in touch</h2><div><p>Message us to book an appointment.</p><p class="action-block"><a class="btn btn--light" href="contact.html">Contact us</a></p></div></div></section>
  </main>
</BaseLayout>
