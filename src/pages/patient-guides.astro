---
import BaseLayout from "../layouts/BaseLayout.astro";
import { guidePath, patientGuides } from "../data/patient-guides";

const structuredData = [{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "@id": "https://draayushshrestha.com/patient-guides.html#webpage",
  url: "https://draayushshrestha.com/patient-guides.html",
  name: "Orthopaedic Patient Guides",
  description: "Patient education about wound care, exercise, spine and knee health, neck pain, disc herniation and warning signs.",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: patientGuides.map((guide, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: guide.title,
      url: `https://draayushshrestha.com${guidePath(guide)}`,
    })),
  },
}];
---

<BaseLayout
  title="Orthopaedic Patient Guides | Dr. Aayush Shrestha"
  description="Read Dr. Aayush Shrestha’s patient education on wound care, exercise, spine and knee health, neck pain, disc herniation and warning signs."
  canonical="https://draayushshrestha.com/patient-guides.html"
  active="patient-guides"
  structuredData={structuredData}
>
  <main id="main">
    <section class="shell page-hero guides-hero"><p class="kicker">Patient education</p><h1>Know your body</h1><p>Health tips, danger signs, and myths and facts about common orthopaedic and spine concerns.</p></section>
    <section class="guide-toolbar" aria-label="Filter patient guides" data-guide-filters>
      <div class="shell guide-toolbar__inner">
        <p class="guide-filter-count" aria-live="polite" data-guide-count>{patientGuides.length} guides</p>
        <div class="guide-filters">
          <button class="guide-filter" type="button" data-guide-filter="all" aria-pressed="true">All guides</button>
          <button class="guide-filter" type="button" data-guide-filter="Health tips" aria-pressed="false">Health tips</button>
          <button class="guide-filter" type="button" data-guide-filter="Danger signs" aria-pressed="false">Danger signs</button>
          <button class="guide-filter" type="button" data-guide-filter="Myths and facts" aria-pressed="false">Myths &amp; facts</button>
        </div>
      </div>
    </section>
    <section class="section section--tight"><div class="shell">
      <div class="guide-library">
        {patientGuides.map((guide) => (
          <article class="guide-post" id={guide.id} data-guide-card data-category={guide.category}>
            <figure class="guide-post__media"><img src={guide.image.src} alt={guide.image.alt} width={guide.image.width} height={guide.image.height} loading="lazy" /></figure>
            <header><p class="kicker">{guide.category}</p><h2>{guide.title}</h2><p><time datetime={guide.updated}>Updated July 22, 2026</time></p></header>
            <a class="guide-read-more" href={guidePath(guide)}><span>Read article</span><span aria-hidden="true">→</span></a>
          </article>
        ))}
      </div>
    </div></section>
    <section class="section"><div class="narrow"><div class="medical-note"><strong>Medical information notice</strong><p>These articles provide general education and do not replace an individual diagnosis or treatment plan. Seek medical attention for severe or rapidly worsening symptoms.</p></div></div></section>
  </main>
</BaseLayout>

<script>
  const toolbar = document.querySelector<HTMLElement>("[data-guide-filters]");

  if (toolbar) {
    const buttons = Array.from(toolbar.querySelectorAll<HTMLButtonElement>("[data-guide-filter]"));
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-guide-card]"));
    const count = toolbar.querySelector<HTMLElement>("[data-guide-count]");

    toolbar.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement).closest<HTMLButtonElement>("[data-guide-filter]");
      if (!button) return;

      const filter = button.dataset.guideFilter;
      let visible = 0;

      buttons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      cards.forEach((card) => {
        const show = filter === "all" || card.dataset.category === filter;
        card.hidden = !show;
        if (show) visible += 1;
      });

      if (count) count.textContent = `${visible} ${visible === 1 ? "guide" : "guides"}`;
    });
  }
</script>
