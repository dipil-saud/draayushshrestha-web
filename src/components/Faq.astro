---
const faqs = [
  {
    question: "Where can I see the doctor?",
    answer: "Kathmandu: Grande International Hospital, Tokha. Lalitpur: Pacific Multispeciality Clinic, Kupondole.",
  },
  {
    question: "When will the doctor be available?",
    answer: "Grande International Hospital, Kathmandu: Sunday to Friday, 9am to 5pm. Pacific Multispeciality Clinic, Lalitpur: Monday to Friday, after 5pm.",
  },
  {
    question: "Can we do an online consultation?",
    answer: "Yes, that is possible.",
  },
  {
    question: "What are the problems treated?",
    answer: "Orthopaedic surgery, spine surgery, non-operative treatment and patient education and awareness.",
  },
  {
    question: "How do I book an appointment?",
    answer: "Call or message the clinic, or use the contact page. Appointment times and clinic location are listed on the contact page.",
  },
  {
    question: "Do I need a referral?",
    answer: "A referral is not required for an initial consultation. If imaging, prior notes or insurance paperwork are needed, the clinic will let you know in advance.",
  },
];

const heading = "Frequently asked questions";
const intro =
  "Quick answers to common questions about the clinic, appointments and the conditions treated.";
const idPrefix = "faq";
---

<section class="shell faq" aria-labelledby={`${idPrefix}-heading`}>
  <header class="faq__head">
    <h2 id={`${idPrefix}-heading`} class="faq__heading">{heading}</h2>
    <p class="faq__intro">{intro}</p>
  </header>
  <div class="faq__list">
    {faqs.map((faq, index) => (
      <details class="faq__item" id={`${idPrefix}-${index}`} open={index === 0}>
        <summary>
          <span>{faq.question}</span>
        </summary>
        <div class="faq__answer">
          <p>{faq.answer}</p>
        </div>
      </details>
    ))}
  </div>
</section>

<style>
  /* Hallmark · section redesign: compact + minimal · system: Studio (preserved) */
  .faq {
    display: grid;
    gap: var(--space-lg);
    padding-block: var(--space-xl);
    border-block-start: var(--rule-width) solid var(--color-rule);
  }
  .faq__head {
    display: grid;
    gap: var(--space-2xs);
    max-width: 48rem;
  }
  .faq__heading {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    letter-spacing: -0.02em;
  }
  .faq__intro {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .faq__list {
    display: grid;
    border-block-start: var(--rule-width) solid var(--color-rule);
  }
  .faq__item {
    border-block-end: var(--rule-width) solid var(--color-rule);
  }
  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-md);
    min-height: 2.75rem;
    padding-block: var(--space-sm);
    color: var(--color-ink);
    font-size: var(--text-base);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }
  .faq__item summary::-webkit-details-marker {
    display: none;
  }
  .faq__item summary::after {
    content: "+";
    flex: 0 0 auto;
    color: var(--color-muted);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1;
    transition: transform var(--dur-short) var(--ease-out), color var(--dur-short) var(--ease-out);
  }
  .faq__item[open] summary::after {
    transform: rotate(45deg);
    color: var(--color-accent-dark);
  }
  .faq__answer {
    padding-block-end: var(--space-md);
    color: var(--color-muted);
    max-width: 48rem;
  }
  .faq__answer p {
    font-size: var(--text-sm);
  }
  @media (hover: hover) and (pointer: fine) {
    .faq__item summary:hover::after { color: var(--color-accent-dark); }
  }
</style>
