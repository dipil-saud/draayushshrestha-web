---
interface Props {
  active: "home" | "about" | "conditions" | "treatments" | "patient-guides" | "contact" | "none";
}

const { active } = Astro.props;
const links = [
  { key: "home", href: "/", label: "Home" },
  { key: "about", href: "/about", label: "About" },
  { key: "conditions", href: "/conditions", label: "What hurts" },
  { key: "treatments", href: "/treatments", label: "Treatments" },
  { key: "patient-guides", href: "/patient-guides", label: "Patient Guides" },
  { key: "contact", href: "/contact", label: "Contact" },
] as const;
---

<header class="site-header" data-header>
  <div class="notice">
    <div class="shell notice__inner">
      <div class="notice__list">
        <p><span>Book Appointment: Pacific Multispeciality Clinic, Kupondole.</span><a href="tel:+97715424290">Call now</a></p>
        <p><span>Book Appointment: Patan Hospital, Lagankhel.</span><a href="tel:+97715522266">Call now</a></p>
      </div>
      <button class="notice__close" type="button" aria-label="Dismiss appointment notice" data-banner-close>×</button>
    </div>
  </div>
  <div class="nav">
    <div class="shell nav__inner">
      <a class="brand" href="/" aria-label="Dr. Aayush Shrestha, Orthopaedic &amp; Spine Surgeon, home">
        <strong>Dr. Aayush Shrestha</strong>
        <span>Orthopaedic &amp; Spine Surgeon</span>
      </a>
      <nav class="nav__links" aria-label="Primary navigation">
        {links.map((link) => <a href={link.href} aria-current={active === link.key ? "page" : undefined}>{link.label}</a>)}
      </nav>
      <div class="nav__actions">
        <a class="btn btn--primary" href="/contact">Book appointment</a>
        <button class="menu-toggle" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="mobile-menu" data-menu-toggle>
          <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><line x1="4" y1="6" x2="16" y2="6"/><line x1="4" y1="10" x2="16" y2="10"/><line x1="4" y1="14" x2="16" y2="14"/></svg>
          <span>Menu</span>
        </button>
      </div>
    </div>
  </div>
  <div class="mobile-menu__overlay" data-mobile-overlay aria-hidden="true"></div>
  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" data-mobile-menu>
    <div class="mobile-menu__inner">
      <button class="mobile-menu__close" type="button" aria-label="Close menu" data-mobile-close>×</button>
      <a class="mobile-menu__appointment" href="/contact">Book appointment</a>
      {links.map((link) => <a href={link.href} aria-current={active === link.key ? "page" : undefined}>{link.label}</a>)}
    </div>
  </nav>
</header>
