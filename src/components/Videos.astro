---
const videos = [
  {
    id: "wM4RQ2V-9c4",
    title: "Spine and orthopaedic education",
  },
  {
    id: "7CQ1i1hfMGg",
    title: "Awareness and prevention",
  },
];

const channelUrl = "https://youtube.com/@dr.AayushShrestha";
---

<section class="videos" aria-labelledby="videos-heading">
  <div class="shell videos__head">
    <div>
      <p class="kicker">Watch and learn</p>
      <h2 id="videos-heading">Videos</h2>
      <p>Selected talks and awareness videos on spine care, orthopaedic conditions and prevention.</p>
    </div>
    <a class="text-link" href={channelUrl} target="_blank" rel="noopener">
      Visit the YouTube channel ↗
    </a>
  </div>
  <div class="shell videos__grid">
    {videos.map((video) => (
      <article class="video-card">
        <div class="video-card__frame">
          <iframe
            src={`https://www.youtube.com/embed/${video.id}`}
            title={video.title}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <h3 class="video-card__title">{video.title}</h3>
      </article>
    ))}
  </div>
</section>

<style>
  .videos {
    display: grid;
    gap: var(--space-2xl);
    padding-block: var(--space-2xl);
    background: var(--color-paper-2);
  }
  .videos__head {
    display: grid;
    gap: var(--space-lg);
    align-items: end;
    grid-template-columns: minmax(0, 1fr);
  }
  .videos__head > div {
    display: grid;
    gap: var(--space-sm);
    max-width: 42rem;
  }
  .videos__head p {
    color: var(--color-muted);
    font-size: var(--text-md);
  }
  .videos__grid {
    display: grid;
    gap: var(--space-lg);
    grid-template-columns: minmax(0, 1fr);
  }
  .video-card {
    display: grid;
    gap: var(--space-sm);
    background: var(--color-surface);
    border: var(--rule-width) solid var(--color-rule);
  }
  .video-card__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-ink);
  }
  .video-card__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-card__title {
    padding: 0 var(--space-lg) var(--space-lg);
    font-size: var(--text-md);
  }
  @media (min-width: 40rem) {
    .videos__head {
      grid-template-columns: minmax(0, 1fr) auto;
    }
    .videos__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
