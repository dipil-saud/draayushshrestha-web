---
const videos = [
  {
    id: "wM4RQ2V-9c4",
    title: "Spine and orthopaedic education",
  },
  {
    id: "7CQ1i1hfMGg",
    title: "Awareness and prevention",
  },
];

const channelUrl = "https://youtube.com/@dr.AayushShrestha";
---

<section class="videos" aria-labelledby="videos-heading">
  <div class="videos__head">
    <div class="videos__copy">
      <h3 id="videos-heading" class="videos__heading">Videos</h3>
      <p class="videos__intro">Selected talks and awareness videos on spine care, orthopaedic conditions and prevention.</p>
    </div>
    <a class="text-link videos__link" href={channelUrl} target="_blank" rel="noopener">
      YouTube channel ↗
    </a>
  </div>
  <div class="videos__grid">
    {videos.map((video) => (
      <article class="video-card">
        <div class="video-card__frame">
          <iframe
            src={`https://www.youtube.com/embed/${video.id}`}
            title={video.title}
            loading="lazy"
            allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
            referrerpolicy="strict-origin-when-cross-origin"
            allowfullscreen
          ></iframe>
        </div>
        <p class="video-card__title">{video.title}</p>
      </article>
    ))}
  </div>
</section>

<style>
  /* Hallmark · subsection of "Know your body": compact + minimal · system: Studio (preserved) */
  .videos {
    display: grid;
    gap: var(--space-lg);
    margin-block-start: var(--space-2xl);
  }
  .videos__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-sm) var(--space-lg);
    padding-block-start: var(--space-xl);
    border-block-start: var(--rule-width) solid var(--color-rule);
  }
  .videos__copy {
    display: grid;
    gap: var(--space-2xs);
    min-width: 0;
  }
  .videos__heading {
    font-size: var(--text-lg);
    letter-spacing: -0.02em;
  }
  .videos__intro {
    color: var(--color-muted);
    font-size: var(--text-sm);
    max-width: 46ch;
  }
  .videos__link {
    flex: 0 0 auto;
  }
  .videos__grid {
    display: grid;
    gap: var(--space-md);
    grid-template-columns: repeat(2, minmax(0, 1fr));
    max-width: 48rem;
  }
  .video-card {
    display: grid;
    gap: var(--space-xs);
    min-width: 0;
  }
  .video-card__frame {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: var(--color-ink);
  }
  .video-card__frame iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }
  .video-card__title {
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  @media (max-width: 30rem) {
    .videos__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
