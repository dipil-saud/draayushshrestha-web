---
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";

interface Props {
  src: ImageMetadata;
  alt: string;
  sizes: string;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
}

const {
  src,
  alt,
  sizes,
  loading = "lazy",
  fetchpriority,
} = Astro.props as Props;

const standardWidths = [320, 480, 640, 800, 960, 1200, 1600];
const widths = standardWidths.filter((width) => width < src.width);
widths.push(src.width);
const isSvg = src.format === "svg";
---

{isSvg ? (
  <img
    src={src.src}
    width={src.width}
    height={src.height}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
) : (
  <Picture
    src={src}
    formats={["avif"]}
    fallbackFormat="webp"
    widths={widths}
    sizes={sizes}
    alt={alt}
    loading={loading}
    fetchpriority={fetchpriority}
    decoding="async"
  />
)}
